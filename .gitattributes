# Shell / Bash
*.sh text eol=lf

# Markdown / 文本
*.md text eol=lf
*.txt text eol=lf

# 配置文件
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf

# Python
*.py text eol=lf

# Jupyter Notebook
*.ipynb text eol=lf

